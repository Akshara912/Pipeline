stages:
  - build
  - test
  - cache
  - docker
  - security

build_stage:
  stage: build
  image: docker
  script:
    - mkdir -p build
    - echo "Build is successful" > build/status.txt

  artifacts:
    paths:
      - build/status.txt

Security_Check:
  stage: test
  image: alpine
  script:
    - echo "security check started"
    - test -f build/status.txt
    - echo "security check completed"

Cache_job:
  stage: cache
  image: alpine
  cache:
    key: Demo-cache
    paths:
      - /demo-cache
  script:
    - mkdir -p demo-cache
    - |
      if test -f /demo-cache/message.txt; then
        echo "cache file exists"
      else 
        echo "creating cache file"
        echo "cache file has been created" > demo-cache/message.txt
      fi
  

docker_stage:
  stage: docker
  image: docker
  services:
    - name: docker:dind
  script:
    - docker build -t "$CI_REGISTRY_IMAGE/car-app:$CI_COMMIT_SHORT_SHA" -t "$CI_REGISTRY_IMAGE/car-app:latest" .
    - docker image inspect "$CI_REGISTRY_IMAGE/car-app:$CI_COMMIT_SHORT_SHA"
    - docker run --rm "$CI_REGISTRY_IMAGE/car-app:$CI_COMMIT_SHORT_SHA" > containerop.txt
    - docker image ls
    - cat containerop.txt
    - grep -q "Build is successful" containerop.txt
    - echo "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" -u "$CI_REGISTRY_USER" --password-stdin
    - docker push "$CI_REGISTRY_IMAGE/car-app:$CI_COMMIT_SHORT_SHA"
    - docker push "$CI_REGISTRY_IMAGE/car-app:latest"

trivy_stage:
  stage: security
  image: 
    name: aquasec/trivy:latest
    entrypoint: [""]
  dependencies: [docker_stage]
  script:
    - trivy --version
    - export TRIVY_USERNAME="$CI_REGISTRY_USER"
    - export TRIVY_PASSWORD="$CI_REGISTRY_PASSWORD"
    - test -n "$TRIVY_USERNAME"
    - test -n "$TRIVY_PASSWORD"
    - trivy image --image-src remote --severity CRITICAL,HIGH "$CI_REGISTRY_IMAGE/car-app:$CI_COMMIT_SHORT_SHA"

    
  


